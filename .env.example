# Clave de OpenAI necesaria para analizar documentos.
OPENAI_API_KEY=

# Modelo utilizado por los agentes y el análisis visual de documentos.
# Debe admitir imágenes y Chat Completions.
OPENAI_MODEL=gpt-4o

# Dirección pública de la API que utiliza el frontend (sin barra final).
VITE_API_URL=http://localhost:8000

# FRAUDE_MOCK_REGISTRY se controla internamente durante el laboratorio
# de documentos sintéticos; no lo configures para análisis reales.
